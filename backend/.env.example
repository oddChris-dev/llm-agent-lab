# LLM Agent Lab - Environment Configuration
# Copy this file to .env and update the values as needed
# Usage: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)

# =============================================================================
# DJANGO SETTINGS
# =============================================================================

# Django secret key - CHANGE THIS IN PRODUCTION!
# Generate a new one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode - set to False in production
DEBUG=True

# Django log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# For development, you can use SQLite (no setup required)
USE_SQLITE=true

# For PostgreSQL (recommended for production)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_lab

# Or individual PostgreSQL settings:
# DB_NAME=agent_lab
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# =============================================================================
# CELERY / REDIS
# =============================================================================

# For development without Redis, use eager mode (tasks run synchronously)
CELERY_EAGER=true

# For production with Redis:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# REDIS_HOST=localhost

# =============================================================================
# LLM PROVIDERS
# =============================================================================

# Default LLM provider (ollama, openai, anthropic)
DEFAULT_LLM_PROVIDER=ollama

# Ollama settings (for local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI API key (if using OpenAI)
# OPENAI_API_KEY=sk-your-api-key-here

# Anthropic API key (if using Claude)
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# =============================================================================
# VOICE PROVIDERS
# =============================================================================

# Default text-to-speech provider (xtts, elevenlabs, openai)
DEFAULT_TTS_PROVIDER=xtts

# Default speech-to-text provider (vosk, whisper, openai)
DEFAULT_STT_PROVIDER=vosk

# ElevenLabs API key (if using ElevenLabs TTS)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key

# =============================================================================
# IMAGE GENERATION
# =============================================================================

# ComfyUI base URL (for Stable Diffusion)
COMFYUI_BASE_URL=http://localhost:8188

# =============================================================================
# EXECUTION SETTINGS
# =============================================================================

# Maximum concurrent workflow executions
MAX_CONCURRENT_EXECUTIONS=5

# Node execution timeout in seconds
NODE_TIMEOUT_SECONDS=300

# Queue maximum size
QUEUE_MAX_SIZE=10000

# =============================================================================
# FILE STORAGE
# =============================================================================

# Asset storage path (defaults to media/assets)
# ASSET_STORAGE_PATH=/path/to/assets

# Temporary audio path (auto-configured for your OS)
# Windows example: C:\Users\YourName\AppData\Local\Temp\agent_lab_audio
# Linux/Mac example: /tmp/agent_lab_audio
# TEMP_AUDIO_PATH=/custom/temp/path

# =============================================================================
# CORS SETTINGS (for development)
# =============================================================================

# Allowed origins for CORS (comma-separated)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
